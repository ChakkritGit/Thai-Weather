# Where the Next.js server (and its /api rewrites) reach the FastAPI backend.
# Needed at build time and run time.
THWX_API_URL=http://127.0.0.1:8000

# Public URL of this site – used for canonical links, sitemap and Open Graph.
SITE_URL=http://localhost:3000

# Optional: call the backend directly from the browser instead of via rewrites
# (requires THWX_CORS_ORIGINS on the backend).
# NEXT_PUBLIC_API_BASE=https://api.example.com
