# Copy to deploy/.env and edit. Never commit the real .env.

# Real global-model data from Open-Meteo (use "demo" for offline testing)
THWX_SOURCE=open-meteo
THWX_OPENMETEO_MODEL=gfs_seamless
# Only for commercial use (paid plan); leave empty for the free tier
THWX_OPENMETEO_API_KEY=
THWX_REFRESH_MINUTES=360
THWX_FALLBACK_TO_DEMO=false

# REQUIRED – protects POST /api/v1/observations and /api/v1/runs
# generate one with:  openssl rand -hex 32
THWX_ADMIN_TOKEN=

# Public URL of the site (canonical links, sitemap, Open Graph)
SITE_URL=https://thai-weather.chakkritton.com

# Image tag from GHCR: latest, or a commit SHA to pin a version
THWX_IMAGE_TAG=latest

# Set to false to skip the full Open-Meteo re-fetch (~2.3k calls) when the api container
# is only restarted/redeployed; the next scheduled run (THWX_REFRESH_MINUTES) then runs as usual.
THWX_RUN_ON_STARTUP=true

# The verify service pushes the latest METAR temperatures of ~3/4 of the stations to
# POST /api/v1/observations every 15 min (station correction). false = verification only.
THWX_VERIFY_PUSH=true

# Radar nowcast ("rain reaches you in N minutes") from RainViewer; "off" disables the radar part.
# RainViewer's free API is for personal/educational use - see docs/NOWCAST.md before running it publicly.
THWX_NOWCAST_SOURCE=rainviewer
# Active tropical cyclones near Thailand from GDACS
THWX_CYCLONES_ENABLED=true
