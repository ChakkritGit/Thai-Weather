&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2026-10-09_00:00:00','2026-10-09_00:00:00',
 end_date   = '2026-10-11_00:00:00','2026-10-11_00:00:00',
 interval_seconds = 10800,
/

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1,  90,
 j_parent_start    =   1,  54,
 e_we              = 280, 340,
 e_sn              = 310, 601,
 geog_data_res     = 'default','default',
 dx = 9000,
 dy = 9000,
 map_proj = 'mercator',
 ref_lat   =  13.0,
 ref_lon   = 101.0,
 truelat1  =  13.0,
 stand_lon = 101.0,
 geog_data_path = '/data/WPS_GEOG/'
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS'
/
