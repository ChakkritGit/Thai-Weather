 &time_control
 run_days                 = 0,
 run_hours                = 48,
 start_year               = 2026, 2026,
 start_month              = 10,   10,
 start_day                = 09,   09,
 start_hour               = 00,   00,
 end_year                 = 2026, 2026,
 end_month                = 10,   10,
 end_day                  = 11,   11,
 end_hour                 = 00,   00,
 interval_seconds         = 10800,
 input_from_file          = .true.,.true.,
 history_interval         = 60,   60,
 frames_per_outfile       = 1,    1,
 restart                  = .false.,
 io_form_history          = 2,
 io_form_restart          = 2,
 io_form_input            = 2,
 io_form_boundary         = 2,
 /

 &domains
 time_step                = 45,
 max_dom                  = 2,
 e_we                     = 280, 340,
 e_sn                     = 310, 601,
 e_vert                   = 45,  45,
 p_top_requested          = 5000,
 num_metgrid_levels       = 34,
 num_metgrid_soil_levels  = 4,
 dx                       = 9000, 3000,
 dy                       = 9000, 3000,
 grid_id                  = 1,    2,
 parent_id                = 0,    1,
 i_parent_start           = 1,    90,
 j_parent_start           = 1,    54,
 parent_grid_ratio        = 1,    3,
 parent_time_step_ratio   = 1,    3,
 feedback                 = 1,
 smooth_option            = 0,
 /

 &physics
 ! Tropical, convection-permitting configuration.
 mp_physics               = 8,    8,     ! Thompson microphysics
 cu_physics               = 16,   0,     ! New Tiedtke at 9 km, explicit convection at 3 km
 ra_lw_physics            = 4,    4,     ! RRTMG
 ra_sw_physics            = 4,    4,
 radt                     = 9,    9,
 bl_pbl_physics           = 1,    1,     ! YSU
 sf_sfclay_physics        = 1,    1,
 sf_surface_physics       = 4,    4,     ! Noah-MP (paddy fields, irrigated land)
 sf_urban_physics         = 1,    1,     ! single-layer urban canopy (Bangkok UHI)
 num_land_cat             = 21,
 sst_update               = 1,           ! Gulf of Thailand / Andaman SST evolve
 icloud                   = 1,
 /

 &dynamics
 hybrid_opt               = 2,
 w_damping                = 1,
 diff_opt                 = 2,    2,
 km_opt                   = 4,    4,
 diff_6th_opt             = 2,    2,
 diff_6th_factor          = 0.12, 0.12,
 damp_opt                 = 3,
 zdamp                    = 5000., 5000.,
 dampcoef                 = 0.2,  0.2,
 non_hydrostatic          = .true., .true.,
 moist_adv_opt            = 1,    1,
 scalar_adv_opt           = 1,    1,
 /

 &bdy_control
 spec_bdy_width           = 5,
 specified                = .true.
 /

 &namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1,
 /
